<script>

function addToCart(event) {

  const btn = event.currentTarget;
  const variantId = btn.dataset.variant;

  if (!variantId) return;

  /* show spinner */

  btn.classList.add("btn-loading");

  fetch('/cart/add.js', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json'
    },
    body: JSON.stringify({
      id: variantId,
      quantity: 1
    })
  })

  .then(res => res.json())

  .then(() => fetch('/?sections=cart-drawer,cart-icon-bubble'))

  .then(res => res.json())

  .then(data => {

    const parser = new DOMParser();
    const currentDrawer = document.querySelector("cart-drawer");

    /* update drawer */

    const drawerHTML = parser.parseFromString(data["cart-drawer"], "text/html");
    const newDrawer = drawerHTML.querySelector("cart-drawer");

    if (newDrawer && currentDrawer) {
      currentDrawer.innerHTML = newDrawer.innerHTML;
      currentDrawer.classList.remove("is-empty");
    }

    /* update cart icon */

    const bubbleHTML = parser.parseFromString(data["cart-icon-bubble"], "text/html");
    const newBubble = bubbleHTML.querySelector("#cart-icon-bubble");
    const currentBubble = document.querySelector("#cart-icon-bubble");

    if (newBubble && currentBubble) {
      currentBubble.innerHTML = newBubble.innerHTML;
    }

    /* open drawer smoothly */

    setTimeout(() => {

      document.body.classList.add("overflow-hidden");
      currentDrawer.classList.add("active");

      if (typeof currentDrawer.open === "function") {
        currentDrawer.open();
      }

    }, 30);

  })

  .catch(err => {
    console.error("Cart error:", err);
  })

  .finally(() => {

    /* remove spinner */

    btn.classList.remove("btn-loading");

  });

}

function closeCartDrawer() {

  const drawer = document.querySelector("cart-drawer");

  drawer.classList.remove("active");

  setTimeout(() => {
    document.body.classList.remove("overflow-hidden");
  }, 350);

}
function addToCart_no_use() {
  const activeButton = document.activeElement?.closest('button[data-variant]');
  const heroButton = activeButton || document.getElementById('heroCta') || document.querySelector('button[data-variant]');
  if (!heroButton) return;

  const variantId = heroButton.dataset.variant;
  const cartDrawer = document.querySelector('cart-drawer');

  window.DawnCartLoading?.setButtonLoading(heroButton, true, 'Adding...');

  const config = fetchConfig('javascript');
  config.headers['X-Requested-With'] = 'XMLHttpRequest';
  delete config.headers['Content-Type'];

  const formData = new FormData();
  formData.append('id', variantId);
  formData.append('quantity', 1);

  if (cartDrawer && typeof cartDrawer.getSectionsToRender === 'function') {
    formData.append(
      'sections',
      cartDrawer.getSectionsToRender().map((section) => section.id)
    );
    formData.append('sections_url', window.location.pathname);
    cartDrawer.setActiveElement(heroButton);
  }

  config.body = formData;

  fetch('/?sections=cart-drawer,cart-icon-bubble')
  .then(res => res.json())
  .then(data => {

    const parser = new DOMParser();
    const html = parser.parseFromString(data["cart-drawer"], "text/html");

    const newDrawer = html.querySelector("cart-drawer");
    const currentDrawer = document.querySelector("cart-drawer");

    if (!newDrawer || !currentDrawer) {
      console.error("Cart drawer not found");
      return;
    }

    /* replace drawer content */

    currentDrawer.innerHTML = newDrawer.innerHTML;

    /* IMPORTANT */

    currentDrawer.classList.remove("is-empty");

    /* update cart icon bubble */

    const bubbleHTML = parser.parseFromString(data["cart-icon-bubble"], "text/html");
    const newBubble = bubbleHTML.querySelector("#cart-icon-bubble");
    const currentBubble = document.querySelector("#cart-icon-bubble");

    if (newBubble && currentBubble) {
      currentBubble.innerHTML = newBubble.innerHTML;
    }

    /* OPEN DRAWER WITH DAWN ANIMATION */

    document.body.classList.add("overflow-hidden");

    currentDrawer.classList.add("animate", "active");

    if (typeof currentDrawer.open === "function") {
      currentDrawer.open();
    }

  })
    .catch((error) => {
      console.error('Cart error:', error);
    })
    .finally(() => {
      window.DawnCartLoading?.setButtonLoading(heroButton, false);
    });
}



document.addEventListener("DOMContentLoaded", function () {

  const container = document.getElementById("zoomContainer");
  const mainImage = document.getElementById("mainProductImage");
  const thumbs = document.querySelectorAll(".se-thumb img");

  if (!container || !mainImage) return;


  /* -----------------------------
     Thumbnail Click Change Image
  ------------------------------*/

  thumbs.forEach(function (thumb) {

    thumb.addEventListener("click", function () {

      const newSrc = this.getAttribute("data-image");
      const zoomSrc = this.getAttribute("data-zoom");

      if (newSrc) {
        mainImage.src = newSrc;
      }

      if (zoomSrc) {
        mainImage.dataset.zoom = zoomSrc;
      }

      document.querySelectorAll(".se-thumb").forEach(function (t) {
        t.classList.remove("active");
      });

      this.parentElement.classList.add("active");

    });

  });


  /* -----------------------------
        Hover Zoom Effect
  ------------------------------*/

  container.addEventListener("mousemove", function (e) {

    const rect = container.getBoundingClientRect();

    const x = ((e.clientX - rect.left) / rect.width) * 100;
    const y = ((e.clientY - rect.top) / rect.height) * 100;

    mainImage.style.transformOrigin = x + "% " + y + "%";
    mainImage.style.transform = "scale(2)";

  });


  /* -----------------------------
        Reset Zoom
  ------------------------------*/

  container.addEventListener("mouseleave", function () {

    mainImage.style.transform = "scale(1)";
    mainImage.style.transformOrigin = "center center";

  });

});
</script>


