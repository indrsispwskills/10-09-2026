(function(){['ic1','ic2','ic3'].forEach(function(id,i){var el=document.getElementById(id);if(!el)return;var ob=new IntersectionObserver(function(es){if(es[0].isIntersecting){setTimeout(function(){el.classList.add('on')},i*200);ob.unobserve(el)}},{threshold:.15});ob.observe(el)})})();

