


{% comment %}
  ReviewFlow manual product page snippet.
  Paste this into a product template/section for quick testing only.
  For a public Shopify App Store app, use the theme app extension app block instead.
{% endcomment %}

{% if product %}
  <div
    id="reviewflow-reviews"
    style="border-top:1px solid #ddd;margin-top:32px;padding-top:24px;"
    data-app-url="https://review-flow-ai-vercel-new.vercel.app/"
    data-store-id="{{ shop.permanent_domain | escape }}"
    data-shopify-product-id="gid://shopify/Product/{{ product.id }}"
    data-product-title="{{ product.title | escape }}"
  >
    <h2>Customer reviews</h2>
    <div id="reviewflow-review-list">Loading reviews...</div>

    <form id="reviewflow-review-form" style="display:grid;gap:12px;max-width:560px;margin-top:24px;">
      <h3>Write a review</h3>

      <label>
        Email
        <input name="customer_email" type="email" autocomplete="email" style="display:block;width:100%;padding:10px;">
      </label>

      <label>
        Rating
        <select name="rating" style="display:block;width:100%;padding:10px;">
          <option value="5">5 stars</option>
          <option value="4">4 stars</option>
          <option value="3">3 stars</option>
          <option value="2">2 stars</option>
          <option value="1">1 star</option>
        </select>
      </label>

      <label>
        Review
        <textarea name="review_text" rows="4" required style="display:block;width:100%;padding:10px;"></textarea>
      </label>

      <button type="submit" style="padding:12px 16px;">Submit review</button>
      <p id="reviewflow-review-message"></p>
    </form>
  </div>

  <script>
    (function () {
      const root = document.getElementById('reviewflow-reviews');
      const list = document.getElementById('reviewflow-review-list');
      const form = document.getElementById('reviewflow-review-form');
      const message = document.getElementById('reviewflow-review-message');
      const appUrl = root.dataset.appUrl.replace(/\/$/, '');

      function escapeHtml(value) {
        return String(value || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      async function loadReviews() {
        const params = new URLSearchParams({
          store_id: root.dataset.storeId,
          shopify_product_id: root.dataset.shopifyProductId
        });

        const response = await fetch(appUrl + '/api/reviews?' + params.toString());
        const result = await response.json();
        const reviews = result.reviews || [];

        if (!reviews.length) {
          list.innerHTML = '<p>No reviews yet.</p>';
          return;
        }

        list.innerHTML = reviews.map(function (review) {
          return [
            '<article style="border:1px solid #ddd;border-radius:8px;padding:16px;margin-bottom:12px;">',
            '<strong>' + '★'.repeat(review.rating || 0) + '</strong>',
            '<p>' + escapeHtml(review.review_text) + '</p>',
            '</article>'
          ].join('');
        }).join('');
      }

      form.addEventListener('submit', async function (event) {
        event.preventDefault();
        const formData = new FormData(form);
        message.textContent = 'Submitting...';

        const response = await fetch(appUrl + '/api/reviews', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            store_id: root.dataset.storeId,
            shopify_product_id: root.dataset.shopifyProductId,
            product_title: root.dataset.productTitle,
            customer_email: formData.get('customer_email') || undefined,
            rating: Number(formData.get('rating')),
            review_text: formData.get('review_text')
          })
        });

        if (!response.ok) {
          message.textContent = 'Review could not be submitted.';
          return;
        }

        form.reset();
        message.textContent = 'Thank you. Your review is awaiting approval.';
      });

      loadReviews().catch(function () {
        list.innerHTML = '<p>Reviews could not be loaded.</p>';
      });
    }());
  </script>
{% endif %}



<!-- ═══ SCIENCE — Animated particles ═══ -->
<div class="w">
<section id="science" class="sec" style="padding:36px 28px;background:linear-gradient(145deg,var(--cream),#fff);border-radius:28px;border:1px solid var(--bdr);box-shadow:var(--sh-sm);position:relative;overflow:hidden">
<div class="particles">
<span style="--x:10%;--y:20%;--tx:40px;--ty:-60px;--s:5px;--c:rgba(176,134,66,.12);--d:5s;--dl:0s"></span>
<span style="--x:80%;--y:30%;--tx:-30px;--ty:-50px;--s:4px;--c:rgba(194,93,78,.1);--d:6s;--dl:1s"></span>
<span style="--x:50%;--y:70%;--tx:20px;--ty:-40px;--s:6px;--c:rgba(94,138,106,.1);--d:7s;--dl:2s"></span>
<span style="--x:20%;--y:80%;--tx:50px;--ty:-30px;--s:3px;--c:rgba(176,134,66,.08);--d:5.5s;--dl:.5s"></span>
</div>
<div class="sh rv" style="position:relative;z-index:1">
<div class="tag" style="color:var(--rose)">
{{ section.settings.science_tag }}
</div>

<h2>{{ section.settings.science_title }}</h2>

<p>
{{ section.settings.science_description }}
</p>
</div>
<div class="grid-3" style="gap:0;margin-bottom:28px;position:relative;z-index:1">
<div class="rv rv-d1" style="padding:24px;border-radius:20px 0 0 20px;background:var(--gold3);text-align:center;border:1px solid rgba(176,134,66,.12);border-right:none">
<div style="font-size:36px;margin-bottom:10px;animation:float 3s ease-in-out infinite">🧬</div>
<div class="tag" style="color:var(--gold)">
{{ section.settings.hormonal_tag }}
</div>

<h4 style="font-size:17px;margin-bottom:8px">
{{ section.settings.hormonal_title }}
</h4>

<p style="font-size:14px;color:var(--mut);line-height:1.6">
{{ section.settings.hormonal_description }}
</p>
</div>
<div class="rv rv-d2" style="display:flex;align-items:center;justify-content:center;padding:0 16px;background:linear-gradient(180deg,var(--gold3),var(--redl))">
<span style="font-family:var(--fh);font-size:36px;font-weight:700;color:var(--red);animation:scaleIn 1s var(--eo)">+</span>
</div>
<div class="rv rv-d3" style="padding:24px;border-radius:0 20px 20px 0;background:var(--redl);text-align:center;border:1px solid rgba(220,38,38,.08);border-left:none">
<div style="font-size:36px;margin-bottom:10px;animation:float 3s ease-in-out infinite .5s">🚿</div>

<div class="tag" style="color:var(--red)">
{{ section.settings.water_tag }}
</div>

<h4 style="font-size:17px;margin-bottom:8px">
{{ section.settings.water_title }}
</h4>

<p style="font-size:14px;color:var(--mut);line-height:1.6">
{{ section.settings.water_description }}
</p>
</div>
</div>

<div class="grid-2" style="gap:16px;margin-bottom:24px;max-width:560px;margin-left:auto;margin-right:auto;position:relative;z-index:1">

<div class="rv-scale" style="text-align:center;padding:20px;border-radius:18px;background:#fff;border:1px solid var(--bdr);box-shadow:var(--sh-sm)">
<div style="font-family:var(--fh);font-size:36px;font-weight:700;color:var(--red)">
{{ section.settings.stat_1_number }}
</div>
<div style="font-size:14px;font-weight:600;color:var(--ink);margin-top:4px">
{{ section.settings.stat_1_title }}
</div>
</div>

<div class="rv-scale" style="text-align:center;padding:20px;border-radius:18px;background:#fff;border:1px solid var(--bdr);box-shadow:var(--sh-sm);transition-delay:.15s">
<div style="font-family:var(--fh);font-size:36px;font-weight:700;color:var(--gold)">
{{ section.settings.stat_2_number }}
</div>
<div style="font-size:14px;font-weight:600;color:var(--ink);margin-top:4px">
{{ section.settings.stat_2_title }}
</div>
<div style="font-size:14px;color:var(--mut)">
{{ section.settings.stat_2_subtitle }}
</div>
</div>

</div>
<div class="rv" style="padding:18px 24px;border-radius:16px;background:var(--sage3);border:1px solid rgba(94,138,106,.12);max-width:600px;margin:0 auto;position:relative;z-index:1"><p style="font-family:var(--fh);font-size:17px;font-weight:600;color:var(--ink);font-style:italic;text-align:center;line-height:1.5;margin:0">You can't stop hormonal changes. But you <em>can</em> stop your water from making them worse.</p></div>
</section>

<div class="divider rv"><span>✦</span></div>
</div>


