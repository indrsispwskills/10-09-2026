      <div class="htc-tl-step active" data-step="0" onclick="goToStep(0)"><div class="htc-tl-dot"><svg viewBox="0 0 40 40"><circle class="htc-tl-track" cx="20" cy="20" r="18"/><circle class="htc-tl-progress" cx="20" cy="20" r="18"/></svg>1</div><div class="htc-tl-label">Unscrew</div></div>
      <div class="htc-tl-step" data-step="1" onclick="goToStep(1)"><div class="htc-tl-dot"><svg viewBox="0 0 40 40"><circle class="htc-tl-track" cx="20" cy="20" r="18"/><circle class="htc-tl-progress" cx="20" cy="20" r="18"/></svg>2</div><div class="htc-tl-label">Swap Filter</div></div>
      <div class="htc-tl-step" data-step="2" onclick="goToStep(2)"><div class="htc-tl-dot"><svg viewBox="0 0 40 40"><circle class="htc-tl-track" cx="20" cy="20" r="18"/><circle class="htc-tl-progress" cx="20" cy="20" r="18"/></svg>3</div><div class="htc-tl-label">Done!</div></div>
    </div>
    <div class="htc-controls"><button class="htc-ctrl" onclick="prevStep()">◀</button><button class="htc-ctrl playing" id="htcPlay" onclick="togglePlay()">❚❚</button><button class="htc-ctrl" onclick="nextStep()">▶</button></div>
  </div>
</section>

