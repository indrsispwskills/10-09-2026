<style>
:root{
  --ink:#1F1D1A;--ink2:#4A4743;--mut:#8A857D;--light:#B5B0A8;
  --cream:#FAF6F0;--cream2:#F5F0E8;--wh:#FFF;--warm:#FEFCF8;
  --rose:#C25D4E;--rosed:#A64A3D;--rose2:rgba(194,93,78,.08);--rose3:#FEF5F3;
  --gold:#B08642;--goldd:#8E6B34;--gold2:rgba(176,134,66,.08);--gold3:#FBF6ED;
  --sage:#5E8A6A;--saged:#4A7254;--sage2:rgba(94,138,106,.08);--sage3:#F0F7F2;
  --navy:#1B3A4B;--red:#DC2626;--redl:#FEF2F2;--success:#16A34A;
  --bdr:#E8E3DA;--bdr2:#D6D0C5;
  --fh:'Cormorant Garamond',Georgia,serif;--fb:'DM Sans',sans-serif;
  --sh-sm:0 2px 8px rgba(31,29,26,.05);--sh-md:0 8px 28px rgba(31,29,26,.07);--sh-lg:0 16px 48px rgba(31,29,26,.1);
  --eo:cubic-bezier(.16,1,.3,1);
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:80px}
body{font-family:var(--fb);background:var(--warm);color:var(--ink);font-size:16px;line-height:1.7;overflow-x:hidden}
h1,h2,h3,h4{font-family:var(--fh);color:var(--ink);line-height:1.25}
a{color:var(--sage);text-decoration:none;font-weight:500;transition:color .2s}
a:hover{color:var(--saged)}
button{font-family:var(--fb);cursor:pointer;border:none}
img{display:block;max-width:100%;border-radius:12px}

/* ═══ LAYOUT ═══ */
.page{max-width:1200px;margin:0 auto;padding:0 24px}

/* ═══ REVEAL ═══ */
.rv{opacity:0;transform:translateY(24px);transition:opacity .7s var(--eo),transform .7s var(--eo)}
.rv.vis{opacity:1;transform:none}
.rv-d1{transition-delay:.1s}.rv-d2{transition-delay:.2s}.rv-d3{transition-delay:.3s}.rv-d4{transition-delay:.4s}
.rv-scale{opacity:0;transform:scale(.9);transition:opacity .7s ease,transform .7s var(--eo)}.rv-scale.vis{opacity:1;transform:none}

/* ═══ KEYFRAMES ═══ */
@keyframes shimmer{0%{transform:translateX(-100%)}100%{transform:translateX(100%)}}
@keyframes gentlePulse{0%,100%{transform:scale(1);opacity:.7}50%{transform:scale(1.04);opacity:1}}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
@keyframes floatSlow{0%,100%{transform:translateY(0) rotate(0deg)}50%{transform:translateY(-12px) rotate(3deg)}}
@keyframes particle{0%{opacity:0;transform:translate(0,0) scale(0)}20%{opacity:.6}80%{opacity:.3}100%{opacity:0;transform:translate(var(--tx),var(--ty)) scale(1)}}
@keyframes glowPulse{0%,100%{box-shadow:0 0 20px rgba(94,138,106,.1)}50%{box-shadow:0 0 40px rgba(94,138,106,.25)}}
@keyframes htcSpin{to{transform:rotate(360deg)}}
@keyframes htcFloat{0%{opacity:0;transform:translateY(20px) scale(0)}25%{opacity:.6;transform:translateY(0) scale(1)}75%{opacity:.4;transform:translateY(-30px) scale(.8)}100%{opacity:0;transform:translateY(-50px) scale(0)}}
@keyframes numPop{0%{transform:scale(0)}100%{transform:scale(1)}}
@keyframes countUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
@keyframes dropFall{0%{opacity:0;transform:translateY(-20px) scale(.7)}15%{opacity:.7}80%{opacity:.4}100%{opacity:0;transform:translateY(160px) scale(.3)}}
@keyframes ripple{0%{transform:scale(.8);opacity:.5}100%{transform:scale(2.5);opacity:0}}

/* ═══ SHARED ═══ */
.badge{display:inline-block;padding:5px 14px;border-radius:20px;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
.badge-sage{color:var(--sage);background:var(--sage3)}
.badge-gold{color:var(--gold);background:var(--gold3)}
.badge-save{color:var(--success);background:#DCFCE7}
.sh{text-align:center;margin-bottom:40px}
.sh h2{font-size:32px;margin-bottom:10px}
.sh p{font-size:16px;color:var(--mut);max-width:540px;margin:0 auto;line-height:1.7}
.divider{display:flex;align-items:center;justify-content:center;gap:12px;margin:56px 0}
.divider::before,.divider::after{content:'';height:1px;flex:1;background:linear-gradient(90deg,transparent,var(--bdr),transparent)}
.divider span{font-size:18px;color:var(--gold)}
.particles{position:absolute;inset:0;overflow:hidden;pointer-events:none;z-index:0}
.particles span{position:absolute;width:var(--s,4px);height:var(--s,4px);border-radius:50%;background:var(--c,rgba(94,138,106,.15));animation:particle var(--d,4s) var(--dl,0s) infinite ease-out;left:var(--x,50%);top:var(--y,50%)}

/* ═══ NAV ═══ */
.topnav{display:flex;justify-content:space-between;align-items:center;padding:18px 0;border-bottom:1px solid var(--bdr)}
.logo{font-family:var(--fh);font-size:28px;font-weight:500;letter-spacing:-.01em;color:var(--ink)}
.logo em{color:var(--sage);font-weight:700;font-style:italic}
.nav-links{display:flex;gap:24px;align-items:center;font-size:14px}
.nav-links a{color:var(--mut);font-weight:500}
.nav-links a:hover{color:var(--sage)}
.cart-btn{background:linear-gradient(135deg,var(--rose),var(--rosed));color:#fff;padding:11px 22px;border-radius:10px;font-size:13px;font-weight:700;box-shadow:0 2px 12px rgba(194,93,78,.25);transition:transform .2s}
.cart-btn:hover{transform:translateY(-2px)}
.breadcrumb{padding:14px 0;font-size:13px;color:var(--light)}
.breadcrumb a{color:var(--mut);font-weight:400}
.breadcrumb span{color:var(--ink);font-weight:500}

/* ═══ HERO ═══ */
.hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;padding:28px 0 64px;align-items:start}
.gallery{position:sticky;top:100px}
.gallery-main{aspect-ratio:1/1;border-radius:20px;overflow:hidden;background:var(--cream);border:1px solid var(--bdr);margin-bottom:12px;display:flex;align-items:center;justify-content:center;box-shadow:var(--sh-md);position:relative}
.gallery-main img{width:100%;height:100%;object-fit:contain;padding:24px;transition:transform .5s var(--eo)}
.gallery-main:hover img{transform:scale(1.05)}
.gallery-main::after{content:'';position:absolute;inset:0;opacity:.03;background-image:radial-gradient(circle,var(--sage) 1px,transparent 1px);background-size:32px 32px;pointer-events:none}
.gallery-thumbs{display:flex;gap:10px}
.thumb{width:80px;height:80px;border-radius:12px;overflow:hidden;border:2px solid var(--bdr);cursor:pointer;background:var(--cream);transition:border-color .2s,box-shadow .2s;display:flex;align-items:center;justify-content:center}
.thumb img{width:100%;height:100%;object-fit:contain;padding:4px;border-radius:8px}
.thumb.active,.thumb:hover{border-color:var(--sage);box-shadow:0 0 0 3px rgba(94,138,106,.15)}

/* Offer panel */
.offer{max-width:540px}
.offer h1{font-size:34px;margin:14px 0 8px;line-height:1.15}
.offer-sub{font-size:16px;color:var(--mut);margin-bottom:20px;line-height:1.7}
.stars{display:flex;gap:3px;align-items:center;margin-bottom:20px}
.star{color:var(--gold);font-size:16px}
.star-text{font-size:13px;color:var(--mut);margin-left:8px;font-weight:500}

/* Purchase Toggle */
.purchase-toggle{display:flex;gap:0;margin-bottom:24px;border-radius:14px;overflow:hidden;border:2px solid var(--bdr);background:var(--cream)}
.pt-option{flex:1;padding:16px 20px;cursor:pointer;transition:all .25s;position:relative;text-align:center}
.pt-option.active.sub{border:2px solid var(--sage);border-radius:12px;margin:-1px;background:var(--sage3)}
.pt-option.active.one{border:2px solid var(--bdr2);border-radius:12px;margin:-1px;background:#fff;box-shadow:var(--sh-sm)}
.pt-label{font-size:14px;font-weight:700;color:var(--ink);display:block;margin-bottom:2px}
.pt-detail{font-size:12px;color:var(--mut)}
.pt-option.sub .pt-detail{color:var(--sage)}
.pt-save{position:absolute;top:-1px;right:12px;background:linear-gradient(135deg,var(--sage),var(--saged));color:#fff;font-size:9px;font-weight:700;letter-spacing:.06em;padding:3px 8px;border-radius:0 0 6px 6px;text-transform:uppercase}

/* Quantity */
.qty-label{font-size:13px;font-weight:600;color:var(--ink);margin-bottom:10px;display:block}
.qty-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:24px}
.qty-card{border:2px solid var(--bdr);border-radius:14px;padding:14px 10px;text-align:center;cursor:pointer;transition:all .25s;background:#fff;position:relative}
.qty-card:hover{border-color:rgba(94,138,106,.4);box-shadow:var(--sh-sm)}
.qty-card.active{border-color:var(--sage);background:var(--sage3);box-shadow:0 0 0 3px rgba(94,138,106,.1)}
.qty-card.best .qty-best{display:block}
.qty-best{display:none;position:absolute;top:-9px;left:50%;transform:translateX(-50%);background:linear-gradient(135deg,var(--gold),var(--goldd));color:#fff;font-size:8px;font-weight:700;letter-spacing:.08em;padding:2px 8px;border-radius:6px;text-transform:uppercase;white-space:nowrap}
.qty-num{font-size:20px;font-weight:700;color:var(--ink);display:block;font-family:var(--fh)}
.qty-price{font-size:13px;color:var(--sage);font-weight:600;margin-top:2px;display:block}
.qty-each{font-size:11px;color:var(--light);display:block;margin-top:1px}

/* Price */
.price-display{display:flex;align-items:baseline;gap:12px;margin-bottom:6px;flex-wrap:wrap}
.price-current{font-size:36px;font-weight:700;color:var(--ink);font-family:var(--fh)}
.price-original{font-size:18px;color:var(--light);text-decoration:line-through}
.price-note{font-size:13px;color:var(--mut);margin-bottom:24px;line-height:1.6}

/* CTA */
.cta-btn{width:100%;padding:18px;border-radius:14px;font-size:17px;font-weight:700;color:#fff;background:linear-gradient(135deg,var(--rose),var(--rosed));box-shadow:0 4px 20px rgba(194,93,78,.3);transition:transform .2s,box-shadow .2s;margin-bottom:12px}
.cta-btn:hover{transform:translateY(-2px);box-shadow:0 6px 28px rgba(194,93,78,.4)}
.cta-btn:active{transform:scale(.97)}

/* Trust */
.trust-row{display:flex;gap:18px;flex-wrap:wrap;margin-bottom:24px}
.trust-item{display:flex;gap:6px;align-items:center;font-size:13px;color:var(--mut)}
.trust-item svg{flex-shrink:0}
.delivery-box{background:var(--cream);border-radius:14px;padding:16px 20px;border:1px solid var(--bdr)}
.delivery-box p{font-size:13px;color:var(--mut);margin:0;line-height:1.6}
.delivery-box strong{color:var(--ink)}

/* ═══ WHY REPLACE ═══ */
.why-grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}
.why-cards{display:flex;flex-direction:column;gap:14px}
.why-card{display:flex;gap:14px;padding:18px 20px;border-radius:16px;background:#fff;border:1px solid var(--bdr);box-shadow:var(--sh-sm);transition:transform .3s var(--eo),box-shadow .3s}
.why-card:hover{box-shadow:var(--sh-md);transform:translateY(-3px)}
.why-card-ico{width:48px;height:48px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0}
.why-card h4{font-size:15px;margin-bottom:4px;font-family:var(--fh)}
.why-card p{font-size:13px;color:var(--mut);margin:0;line-height:1.6}
.why-visual{border-radius:24px;overflow:hidden;box-shadow:var(--sh-lg);position:relative}
.why-visual img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:0}
.why-visual::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 60%,rgba(31,29,26,.2));pointer-events:none;border-radius:0}

/* ═══ WHAT'S INSIDE ═══ */
.inside-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;max-width:920px;margin:0 auto}
.inside-card{text-align:center;padding:32px 24px;border-radius:20px;background:#fff;border:1px solid var(--bdr);box-shadow:var(--sh-sm);transition:transform .4s var(--eo),box-shadow .4s;position:relative;overflow:hidden}
.inside-card:hover{transform:translateY(-6px);box-shadow:var(--sh-md)}
.inside-card::before{content:'';position:absolute;top:0;left:0;right:0;height:4px;transform:scaleX(0);transform-origin:left;transition:transform 1s var(--eo) .3s}
.inside-card.on::before{transform:scaleX(1)}
.inside-card:nth-child(1)::before{background:linear-gradient(90deg,var(--sage),var(--saged))}
.inside-card:nth-child(2)::before{background:linear-gradient(90deg,var(--gold),var(--goldd))}
.inside-card:nth-child(3)::before{background:linear-gradient(90deg,var(--navy),#2D5A6B)}
.inside-ico{width:72px;height:72px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:32px;margin:0 auto 16px;transition:transform .6s var(--eo),box-shadow .5s ease .2s}
.inside-card.on .inside-ico{transform:scale(1.1);box-shadow:0 0 0 8px rgba(94,138,106,.06),0 0 30px rgba(94,138,106,.08)}
.inside-card h4{font-size:18px;margin-bottom:8px}
.inside-card p{font-size:14px;color:var(--mut);line-height:1.65;margin:0}
.inside-eff{height:8px;border-radius:4px;background:#f3f0eb;margin-top:16px;overflow:hidden}
.inside-eff-fill{height:100%;border-radius:4px;width:0;transition:width 1.8s var(--eo) .5s;position:relative}
.inside-eff-fill::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(255,255,255,.35),transparent);animation:shimmer 2s infinite}

/* ═══ HOW TO CHANGE ═══ */
.htc-viewer{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;min-height:420px}
.htc-visual{position:relative;aspect-ratio:1/1;max-width:440px;margin:0 auto;width:100%}
.htc-img-wrap{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;opacity:0;transform:scale(.9);transition:opacity .6s var(--eo),transform .6s var(--eo);pointer-events:none}
.htc-img-wrap.active{opacity:1;transform:scale(1);pointer-events:auto}
.htc-img-wrap img{width:85%;height:85%;object-fit:contain;border-radius:16px;filter:drop-shadow(0 8px 32px rgba(31,29,26,.1))}
.htc-particles{position:absolute;inset:0;pointer-events:none;overflow:hidden;border-radius:50%}
.htc-particle{position:absolute;width:6px;height:6px;border-radius:50%;opacity:0}
.htc-img-wrap.active .htc-particle{animation:htcFloat 3s ease-in-out infinite}
.htc-ring{position:absolute;inset:-8px;border-radius:50%;border:3px solid transparent;pointer-events:none}
.htc-ring-track{border-color:var(--bdr)}
.htc-ring-progress{border-color:transparent;border-top-color:var(--sage);animation:htcSpin 4s linear infinite}
.htc-glow{position:absolute;inset:10%;border-radius:50%;background:radial-gradient(circle,rgba(94,138,106,.08),transparent 70%);opacity:1;pointer-events:none;animation:gentlePulse 4s ease-in-out infinite}

/* Step content */
.htc-content{position:relative;min-height:340px}
.htc-step-content{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;opacity:0;transform:translateX(30px);transition:opacity .5s var(--eo),transform .5s var(--eo);pointer-events:none}
.htc-step-content.active{opacity:1;transform:none;pointer-events:auto}
.htc-step-num{display:flex;align-items:center;gap:12px;margin-bottom:16px}
.htc-num-circle{width:48px;height:48px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:700;position:relative;overflow:hidden}
.htc-num-circle .num-bg{position:absolute;inset:0;border-radius:50%;background:var(--sage3);transition:transform .4s var(--eo)}
.htc-step-content.active .num-bg{animation:numPop .5s var(--eo)}
.htc-num-circle b{position:relative;z-index:1;color:var(--sage)}
.htc-step-tag{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--sage);padding:4px 12px;border-radius:12px;background:var(--sage3)}
.htc-step-title{font-family:var(--fh);font-size:24px;color:var(--ink);margin-bottom:10px}
.htc-step-desc{font-size:15px;color:var(--mut);line-height:1.7;margin-bottom:16px}
.htc-step-tip{display:flex;gap:10px;padding:14px 18px;border-radius:14px;background:var(--cream);border:1px solid var(--bdr)}
.htc-step-tip-icon{font-size:18px;flex-shrink:0;margin-top:1px}
.htc-step-tip p{font-size:13px;color:var(--mut);line-height:1.5;margin:0}

/* Timeline */
.htc-timeline{display:flex;align-items:center;max-width:720px;margin:48px auto 0;position:relative}
.htc-tl-step{flex:1;display:flex;flex-direction:column;align-items:center;cursor:pointer;position:relative;z-index:1;padding:8px 0}
.htc-tl-step:hover .htc-tl-dot{transform:scale(1.15)}
.htc-tl-dot{width:42px;height:42px;border-radius:50%;background:#fff;border:3px solid var(--bdr);display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;color:var(--light);transition:all .4s var(--eo);position:relative;z-index:2;font-family:var(--fh)}
.htc-tl-step.active .htc-tl-dot{border-color:var(--sage);background:var(--sage);color:#fff;box-shadow:0 0 0 6px rgba(94,138,106,.15);transform:scale(1.1)}
.htc-tl-step.done .htc-tl-dot{border-color:var(--sage);background:var(--sage3);color:var(--sage)}
.htc-tl-dot svg{position:absolute;inset:-3px;width:calc(100% + 6px);height:calc(100% + 6px)}
.htc-tl-dot svg circle{fill:none;stroke-width:3;stroke-linecap:round}
.htc-tl-track{stroke:transparent}
.htc-tl-progress{stroke:var(--sage);stroke-dasharray:113;stroke-dashoffset:113;transition:stroke-dashoffset .1s linear;transform:rotate(-90deg);transform-origin:center}
.htc-tl-label{font-size:11px;color:var(--light);font-weight:600;margin-top:8px;text-align:center;max-width:80px;line-height:1.3;transition:color .3s}
.htc-tl-step.active .htc-tl-label,.htc-tl-step.done .htc-tl-label{color:var(--sage)}
.htc-tl-line{position:absolute;top:28px;left:0;right:0;height:3px;background:var(--bdr);z-index:0;border-radius:2px}
.htc-tl-fill{position:absolute;top:0;left:0;height:100%;background:linear-gradient(90deg,var(--sage),var(--saged));border-radius:2px;transition:width .5s var(--eo);width:0}
.htc-controls{display:flex;justify-content:center;gap:12px;margin-top:24px}
.htc-ctrl{width:42px;height:42px;border-radius:50%;background:#fff;border:1px solid var(--bdr);display:flex;align-items:center;justify-content:center;font-size:16px;color:var(--mut);transition:all .2s;box-shadow:var(--sh-sm)}
.htc-ctrl:hover,.htc-ctrl.playing{border-color:var(--sage);color:var(--sage);background:var(--sage3)}

/* ═══ DECLINE VISUAL ═══ */
.decline-wrap{position:relative;padding:40px 32px;border-radius:28px;background:linear-gradient(145deg,var(--cream),#fff);border:1px solid var(--bdr);box-shadow:var(--sh-sm);overflow:hidden}
.decline-wrap::after{content:'';position:absolute;top:-20%;right:-10%;width:200px;height:200px;border-radius:50%;background:radial-gradient(circle,rgba(194,93,78,.06),transparent);animation:floatSlow 8s ease-in-out infinite;pointer-events:none}
.decline-bar{height:14px;border-radius:7px;background:#f3f0eb;margin-bottom:8px;overflow:hidden;position:relative}
.decline-fill{height:100%;border-radius:7px;transition:width 2s var(--eo);position:relative}
.decline-fill::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(255,255,255,.3),transparent);animation:shimmer 2s infinite}

/* ═══ FAQ ═══ */
.faq-item{border-bottom:1px solid var(--bdr)}
.faq-q{display:flex;justify-content:space-between;align-items:center;padding:20px 0;cursor:pointer;gap:16px;-webkit-tap-highlight-color:transparent}
.faq-q h4{font-size:16px;font-weight:600;font-family:var(--fb);color:var(--ink);margin:0;flex:1}
.faq-arrow{width:30px;height:30px;border-radius:50%;background:var(--cream);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:13px;color:var(--mut);transition:transform .4s var(--eo),background .3s,color .3s}
.faq-item.open .faq-arrow{transform:rotate(180deg);background:var(--sage3);color:var(--sage)}
.faq-a{max-height:0;overflow:hidden;transition:max-height .5s var(--eo),padding .4s}
.faq-item.open .faq-a{max-height:300px;padding-bottom:20px}
.faq-a p{font-size:15px;color:var(--mut);line-height:1.7;margin:0}

/* ═══ SUBSCRIBE BANNER ═══ */
.sub-banner{padding:56px 36px;border-radius:28px;background:linear-gradient(150deg,#1A1816,var(--ink) 50%,#2D2A26);color:#fff;text-align:center;position:relative;overflow:hidden;margin-bottom:48px}
.sub-banner::before{content:'';position:absolute;inset:0;opacity:.04;background-image:radial-gradient(circle,#fff 1px,transparent 1px);background-size:48px 48px}
.sub-banner::after{content:'';position:absolute;bottom:-40%;left:50%;transform:translateX(-50%);width:400px;height:400px;background:radial-gradient(circle,rgba(94,138,106,.15),transparent 60%);border-radius:50%;animation:floatSlow 10s ease-in-out infinite}
.sub-banner>*{position:relative;z-index:1}
.sub-banner h2{color:#fff;font-size:30px;margin-bottom:12px}
