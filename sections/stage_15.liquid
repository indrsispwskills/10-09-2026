<style>
:root{
  --ink:#1F1D1A;--mut:#8A857D;--light:#B5B0A8;
  --cream:#FAF6F0;--warm:#FEFCF8;--wh:#FFF;
  --sage:#5E8A6A;--saged:#4A7254;--sage2:rgba(94,138,106,.08);--sage3:#EBF2ED;--sage4:#D4E5D8;
  --navy:#1B3A4B;--navyd:#0F2027;
  --gold:#B08642;--goldd:#8E6B34;--gold3:#FBF6ED;--gold4:#F5EDE3;
  --rose:#C25D4E;--rosed:#A64A3D;--rose3:#FEF5F3;
  --sage:#5E8A6A;--sage3:#F0F7F2;
  --success:#16A34A;
  --bdr:#E8E3DA;
  --fh:'Cormorant Garamond',Georgia,serif;--fb:'DM Sans',sans-serif;
  --sh-sm:0 2px 8px rgba(31,29,26,.05);--sh-md:0 8px 28px rgba(31,29,26,.07);--sh-lg:0 16px 48px rgba(31,29,26,.1);
  --eo:cubic-bezier(.16,1,.3,1);
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:80px}
body{font-family:var(--fb);background:var(--warm);color:var(--ink);font-size:16px;line-height:1.7;overflow-x:hidden}
h1,h2,h3,h4{font-family:var(--fh);color:var(--ink);line-height:1.25}
a{color:var(--sage);text-decoration:none;font-weight:500;transition:color .2s}a:hover{color:var(--saged)}
button{font-family:var(--fb);cursor:pointer;border:none}
img{display:block;max-width:100%;border-radius:12px}
.page{max-width:1200px;margin:0 auto;padding:0 24px}

/* ═══ REVEAL ═══ */
.rv{opacity:0;transform:translateY(24px);transition:opacity .7s var(--eo),transform .7s var(--eo)}.rv.vis{opacity:1;transform:none}
.rv-d1{transition-delay:.1s}.rv-d2{transition-delay:.2s}.rv-d3{transition-delay:.3s}.rv-d4{transition-delay:.4s}

/* ═══ KEYFRAMES ═══ */
@keyframes shimmer{0%{transform:translateX(-100%)}100%{transform:translateX(100%)}}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
@keyframes floatSlow{0%,100%{transform:translateY(0) rotate(0deg)}50%{transform:translateY(-12px) rotate(3deg)}}
@keyframes gentlePulse{0%,100%{transform:scale(1);opacity:.7}50%{transform:scale(1.04);opacity:1}}
@keyframes particle{0%{opacity:0;transform:translate(0,0) scale(0)}20%{opacity:.6}80%{opacity:.3}100%{opacity:0;transform:translate(var(--tx),var(--ty)) scale(1)}}
@keyframes numPop{0%{transform:scale(0)}100%{transform:scale(1)}}
@keyframes dropFall{0%{opacity:0;transform:translateY(-20px)}30%{opacity:.7}100%{opacity:0;transform:translateY(40px)}}
@keyframes ringPulse{0%,100%{box-shadow:0 0 0 0 rgba(94,138,106,.2)}50%{box-shadow:0 0 0 12px rgba(94,138,106,0)}}
@keyframes waterFlow{0%{background-position:0 0}100%{background-position:0 40px}}

/* ═══ SHARED ═══ */
.badge{display:inline-block;padding:5px 14px;border-radius:20px;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
.badge-sage{color:var(--sage);background:var(--sage3)}
.badge-navy{color:#fff;background:linear-gradient(135deg,var(--navy),var(--navyd));box-shadow:0 2px 8px rgba(27,58,75,.2)}
.badge-gold{color:var(--gold);background:var(--gold3)}
.badge-save{color:var(--success);background:#DCFCE7}
.sh{text-align:center;margin-bottom:40px}.sh h2{font-size:32px;margin-bottom:10px}.sh p{font-size:16px;color:var(--mut);max-width:540px;margin:0 auto;line-height:1.7}
.sage-line{display:block;width:48px;height:3px;background:linear-gradient(90deg,var(--sage),var(--saged));border-radius:2px;margin:0 auto 16px}
.divider{display:flex;align-items:center;justify-content:center;gap:12px;margin:56px 0}.divider::before,.divider::after{content:'';height:1px;flex:1;background:linear-gradient(90deg,transparent,var(--bdr),transparent)}.divider i{font-size:18px;color:var(--sage);font-style:normal}

/* ═══ NAV ═══ */
.topnav{display:flex;justify-content:space-between;align-items:center;padding:18px 0;border-bottom:1px solid var(--bdr)}
.logo{font-family:var(--fh);font-size:28px;font-weight:500;letter-spacing:-.01em;color:var(--ink)}.logo em{color:var(--sage);font-weight:700;font-style:italic}
.nav-links{display:flex;gap:24px;align-items:center;font-size:14px}.nav-links a{color:var(--mut);font-weight:500}
.cart-btn{background:linear-gradient(135deg,var(--sage),var(--saged));color:#fff;padding:11px 22px;border-radius:10px;font-size:13px;font-weight:700;box-shadow:0 2px 12px rgba(94,138,106,.25);transition:transform .2s}.cart-btn:hover{transform:translateY(-2px)}
.breadcrumb{padding:14px 0;font-size:13px;color:var(--light)}.breadcrumb a{color:var(--mut);font-weight:400}.breadcrumb b{color:var(--ink);font-weight:500}

/* ═══ HERO ═══ */
.hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;padding:28px 0 64px;align-items:start}
.gallery{position:sticky;top:100px}
.gallery-main{aspect-ratio:1/1;border-radius:20px;overflow:hidden;background:var(--cream);border:1px solid var(--bdr);margin-bottom:12px;display:flex;align-items:center;justify-content:center;box-shadow:var(--sh-md);position:relative}
.gallery-main img{width:100%;height:100%;object-fit:contain;padding:20px;transition:transform .5s var(--eo)}.gallery-main:hover img{transform:scale(1.05)}
.gallery-main::after{content:'';position:absolute;top:0;right:0;width:80px;height:80px;background:linear-gradient(135deg,transparent 50%,rgba(94,138,106,.05) 50%);border-radius:0 20px 0 0;pointer-events:none}
.gallery-thumbs{display:flex;gap:10px;overflow-x:auto}
.thumb{width:72px;height:72px;border-radius:12px;overflow:hidden;border:2px solid var(--bdr);cursor:pointer;background:var(--cream);transition:border-color .2s,box-shadow .2s;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.thumb img{width:100%;height:100%;object-fit:contain;padding:4px;border-radius:8px}
.thumb.active,.thumb:hover{border-color:var(--sage);box-shadow:0 0 0 3px rgba(94,138,106,.15)}

/* Offer */
.offer{max-width:540px}
.offer h1{font-size:32px;margin:14px 0 8px;line-height:1.15}
.offer-sub{font-size:16px;color:var(--mut);margin-bottom:20px;line-height:1.7}
.stars{display:flex;gap:3px;align-items:center;margin-bottom:20px}.star{color:var(--gold);font-size:16px}.star-text{font-size:13px;color:var(--mut);margin-left:8px;font-weight:500}

/* Compat callout */
.compat-banner{padding:14px 18px;border-radius:14px;background:linear-gradient(135deg,var(--sage2),rgba(94,138,106,.04));border:1px solid rgba(94,138,106,.15);margin-bottom:20px;display:flex;gap:12px;align-items:center}
.compat-banner .cb-icon{font-size:28px;flex-shrink:0}
.compat-banner p{font-size:13px;color:var(--mut);margin:0;line-height:1.5}
.compat-banner strong{color:var(--ink)}

/* Qty */
.qty-label{font-size:13px;font-weight:600;color:var(--ink);margin-bottom:10px;display:block}
.qty-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:24px}
.qty-card{border:2px solid var(--bdr);border-radius:14px;padding:14px 10px;text-align:center;cursor:pointer;transition:all .25s;background:#fff;position:relative}
.qty-card:hover{border-color:rgba(94,138,106,.4);box-shadow:var(--sh-sm)}
.qty-card.active{border-color:var(--sage);background:var(--sage3);box-shadow:0 0 0 3px rgba(94,138,106,.1)}
.qty-card.best .qty-best{display:block}
.qty-best{display:none;position:absolute;top:-9px;left:50%;transform:translateX(-50%);background:linear-gradient(135deg,var(--gold),var(--goldd));color:#fff;font-size:8px;font-weight:700;letter-spacing:.08em;padding:2px 8px;border-radius:6px;text-transform:uppercase;white-space:nowrap}
.qty-num{font-size:20px;font-weight:700;color:var(--ink);display:block;font-family:var(--fh)}
.qty-price{font-size:13px;color:var(--sage);font-weight:600;margin-top:2px;display:block}
.qty-each{font-size:11px;color:var(--light);display:block;margin-top:1px}
.price-display{display:flex;align-items:baseline;gap:12px;margin-bottom:6px;flex-wrap:wrap}
.price-current{font-size:36px;font-weight:700;color:var(--ink);font-family:var(--fh)}
.price-original{font-size:18px;color:var(--light);text-decoration:line-through}
.price-note{font-size:13px;color:var(--mut);margin-bottom:24px}

/* CTA — teal */
.cta-btn{width:100%;padding:18px;border-radius:14px;font-size:17px;font-weight:700;color:#fff;background:linear-gradient(135deg,var(--sage),var(--saged));box-shadow:0 4px 20px rgba(94,138,106,.3);transition:transform .2s,box-shadow .2s;margin-bottom:12px}
.cta-btn:hover{transform:translateY(-2px);box-shadow:0 6px 28px rgba(94,138,106,.4)}
.cta-btn:active{transform:scale(.97)}

/* Trust */
.trust-row{display:flex;gap:18px;flex-wrap:wrap;margin-bottom:24px}
.trust-item{display:flex;gap:6px;align-items:center;font-size:13px;color:var(--mut)}
.delivery-box{background:var(--sage3);border-radius:14px;padding:16px 20px;border:1px solid rgba(94,138,106,.1)}
.delivery-box p{font-size:13px;color:var(--mut);margin:0;line-height:1.6}
.delivery-box strong{color:var(--ink)}

/* ═══ WHY ═══ */
.why-grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}
.why-cards{display:flex;flex-direction:column;gap:14px}
.why-card{display:flex;gap:14px;padding:18px 20px;border-radius:16px;background:#fff;border:1px solid var(--bdr);box-shadow:var(--sh-sm);transition:transform .3s var(--eo),box-shadow .3s}
.why-card:hover{box-shadow:var(--sh-md);transform:translateY(-3px)}
.why-ico{width:48px;height:48px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0}
.why-card h4{font-size:15px;margin-bottom:4px;font-family:var(--fh)}
.why-card p{font-size:13px;color:var(--mut);margin:0;line-height:1.6}
.why-visual{border-radius:24px;overflow:hidden;box-shadow:var(--sh-lg);position:relative}
.why-visual img{width:100%;aspect-ratio:4/5;object-fit:contain;border-radius:0;padding:20px;background:var(--cream)}

/* ═══ INSIDE ═══ */
.inside-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;max-width:920px;margin:0 auto}
.inside-card{text-align:center;padding:32px 24px;border-radius:20px;background:#fff;border:1px solid var(--bdr);box-shadow:var(--sh-sm);transition:transform .4s var(--eo),box-shadow .4s;position:relative;overflow:hidden}
.inside-card:hover{transform:translateY(-6px);box-shadow:var(--sh-md)}
.inside-card::before{content:'';position:absolute;top:0;left:0;right:0;height:4px;transform:scaleX(0);transform-origin:left;transition:transform 1s var(--eo) .3s}
.inside-card.on::before{transform:scaleX(1)}
.inside-card:nth-child(1)::before{background:linear-gradient(90deg,var(--sage),var(--saged))}
.inside-card:nth-child(2)::before{background:linear-gradient(90deg,var(--sage),#4A7254)}
.inside-card:nth-child(3)::before{background:linear-gradient(90deg,var(--gold),var(--goldd))}
.inside-ico{width:72px;height:72px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:32px;margin:0 auto 16px;transition:transform .6s var(--eo)}
.inside-card.on .inside-ico{transform:scale(1.1)}
.inside-card h4{font-size:18px;margin-bottom:8px}
.inside-card p{font-size:14px;color:var(--mut);line-height:1.65;margin:0}
.inside-eff{height:8px;border-radius:4px;background:#f3f0eb;margin-top:16px;overflow:hidden}
.inside-eff-fill{height:100%;border-radius:4px;width:0;transition:width 1.8s var(--eo) .5s;position:relative}
.inside-eff-fill::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(255,255,255,.35),transparent);animation:shimmer 2s infinite}

/* ═══ COMPAT ═══ */
.compat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;max-width:720px;margin:0 auto}
.compat-item{text-align:center;padding:28px 16px;border-radius:20px;background:#fff;border:1px solid var(--bdr);box-shadow:var(--sh-sm);transition:transform .3s var(--eo),box-shadow .3s}
.compat-item:hover{transform:translateY(-4px);box-shadow:var(--sh-md)}
.compat-emoji{font-size:40px;margin-bottom:12px;display:block}
.compat-item h4{font-size:15px;margin-bottom:4px}
.compat-item p{font-size:12px;color:var(--mut);margin:0;line-height:1.5}

/* ═══ INSTALL ═══ */
.install-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;max-width:960px;margin:0 auto}
.install-card{text-align:center;position:relative}
.install-num{width:48px;height:48px;border-radius:50%;background:linear-gradient(135deg,var(--sage),var(--saged));color:#fff;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:700;font-family:var(--fh);margin:0 auto 16px;box-shadow:0 4px 16px rgba(94,138,106,.25);animation:ringPulse 3s infinite}
.install-img{border-radius:16px;overflow:hidden;background:var(--cream);border:1px solid var(--bdr);margin-bottom:16px;aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;box-shadow:var(--sh-sm)}
.install-img img{width:100%;height:100%;object-fit:contain;border-radius:0;padding:12px}
.install-card h4{font-size:17px;margin-bottom:6px}
.install-card p{font-size:13px;color:var(--mut);line-height:1.6;margin:0}

/* ═══ REMOVES ═══ */
.removes-wrap{position:relative;padding:40px 32px;border-radius:28px;background:linear-gradient(145deg,var(--cream),#fff);border:1px solid var(--bdr);box-shadow:var(--sh-sm);overflow:hidden;max-width:800px;margin:0 auto}
.removes-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.removes-item{display:flex;gap:10px;align-items:center;padding:12px 16px;border-radius:12px;background:var(--sage3);border:1px solid rgba(94,138,106,.08);transition:transform .2s}
.removes-item:hover{transform:translateX(4px)}
.removes-check{font-size:18px;flex-shrink:0}
.removes-item span{font-size:14px;color:var(--ink);font-weight:500}

/* ═══ FAQ ═══ */
.faq-item{border-bottom:1px solid var(--bdr)}
.faq-q{display:flex;justify-content:space-between;align-items:center;padding:20px 0;cursor:pointer;gap:16px}
.faq-q h4{font-size:16px;font-weight:600;font-family:var(--fb);color:var(--ink);margin:0;flex:1}
.faq-arrow{width:30px;height:30px;border-radius:50%;background:var(--cream);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:13px;color:var(--mut);transition:transform .4s var(--eo),background .3s,color .3s}
.faq-item.open .faq-arrow{transform:rotate(180deg);background:var(--sage3);color:var(--sage)}
.faq-a{max-height:0;overflow:hidden;transition:max-height .5s var(--eo),padding .4s}
.faq-item.open .faq-a{max-height:300px;padding-bottom:20px}
.faq-a p{font-size:15px;color:var(--mut);line-height:1.7;margin:0}

/* ═══ FINAL CTA ═══ */
.final-cta{padding:56px 36px;border-radius:28px;background:linear-gradient(150deg,var(--navyd),var(--navy) 50%,#234B5C);color:#fff;text-align:center;position:relative;overflow:hidden;margin-bottom:48px}
.final-cta::before{content:'';position:absolute;inset:0;opacity:.04;background-image:radial-gradient(circle,#fff 1px,transparent 1px);background-size:48px 48px}
.final-cta::after{content:'';position:absolute;bottom:-40%;left:50%;transform:translateX(-50%);width:400px;height:400px;background:radial-gradient(circle,rgba(94,138,106,.15),transparent 60%);border-radius:50%;animation:floatSlow 10s ease-in-out infinite}
.final-cta>*{position:relative;z-index:1}
.final-cta h2{color:#fff;font-size:30px;margin-bottom:12px}
.final-cta>p{color:rgba(255,255,255,.55);font-size:16px;margin-bottom:28px;max-width:520px;margin-left:auto;margin-right:auto;line-height:1.7}
.final-perks{display:flex;gap:32px;justify-content:center;flex-wrap:wrap;margin-bottom:28px}
.final-perk{text-align:center}.final-perk-icon{font-size:28px;margin-bottom:6px}.final-perk-label{font-size:13px;color:rgba(255,255,255,.6);font-weight:500}
.final-btn{display:inline-block;padding:16px 44px;border-radius:14px;background:linear-gradient(135deg,var(--sage),var(--saged));color:#fff;font-size:16px;font-weight:700;box-shadow:0 4px 20px rgba(94,138,106,.35);transition:transform .2s;border:none;cursor:pointer}.final-btn:hover{transform:translateY(-2px);color:#fff}

/* ═══ FOOTER ═══ */
.footer{padding:36px 0 48px;border-top:1px solid var(--bdr)}
.footer-inner{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px}
.footer-links{display:flex;gap:20px;font-size:13px;flex-wrap:wrap}.footer-links a{color:var(--mut)}
.footer-copy{font-size:12px;color:var(--light)}
.scroll-top{position:fixed;bottom:28px;right:28px;width:46px;height:46px;border-radius:50%;background:linear-gradient(135deg,var(--sage),var(--saged));color:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(94,138,106,.3);opacity:0;transform:translateY(20px);transition:opacity .3s,transform .3s;z-index:200;font-size:18px;border:none;cursor:pointer}.scroll-top.show{opacity:1;transform:none}

@media(min-width:768px){.page{padding:0 40px}.sh h2{font-size:38px}}
@media(max-width:767px){
  .hero-grid{display:block}.gallery{position:static;margin-bottom:32px}
  .offer{max-width:100%}.offer h1{font-size:26px}
  .why-grid{display:block}.why-visual{margin-top:28px}
  .inside-grid{grid-template-columns:1fr;max-width:400px}
  .compat-grid{grid-template-columns:1fr 1fr;gap:12px}
  .install-grid{grid-template-columns:1fr;max-width:400px;gap:20px}
  .removes-grid{grid-template-columns:1fr}
  .removes-wrap{padding:24px 16px}
  .final-perks{gap:20px}.sh h2{font-size:28px}
  .nav-links a:not(:last-child){display:none}
  .qty-grid{gap:6px}.qty-card{padding:12px 6px}
  .footer-inner{flex-direction:column;align-items:flex-start}
}
@media(prefers-reduced-motion:reduce){.rv{opacity:1;transform:none;transition:none}}
</style>
</head>
<body>
<div class="page">

<!-- ═══ NAV ═══ -->
<nav class="topnav rv">
  <div style="display:flex;align-items:center;gap:24px">
    <div class="logo"><svg class="brand-mark" width="24" height="24" viewBox="0 0 32 32" style="vertical-align:middle;margin-right:6px"><circle cx="16" cy="16" r="14" fill="var(--sage)" opacity=".12"/><path d="M16 8v5M12 16c0-2.2 1.8-4 4-4s4 1.8 4 4M13 19s1 3 3 3 3-3 3-3" stroke="var(--sage)" stroke-width="2" stroke-linecap="round" fill="none"/><circle cx="16" cy="24" r="1.2" fill="var(--sage)"/></svg>Shower<em>Envy</em></div>
    <div class="nav-links"><a href="#">Home</a><a href="#">2.0 Handheld</a><a href="#">5.0 Stationary</a><a href="#">Science</a><a href="#">Reviews</a></div>
  </div>
