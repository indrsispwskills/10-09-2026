</nav>
<div class="breadcrumb rv rv-d1"><a href="#">Home</a> / <a href="#">Collection</a> / <b>15-Stage Filter Upgrade</b></div>

<!-- ═══════════════════════════════════
     HERO
     ═══════════════════════════════════ -->
<section class="hero-grid">
  <div class="gallery rv">
    <div class="gallery-main"><img src="https://showerenvy.com/cdn/shop/products/186845_ff7895c807874d80bc187d5668df6e82_mv2_1865b7e1-e296-4f4d-a8bf-7f2c5ef6bdc6.jpg?v=1762634682" alt="ShowerEnvy 15-Stage Filter Upgrade — universal fit, vitamin C & E" id="mainImg"></div>
    <div class="gallery-thumbs">
      <div class="thumb active" onclick="swapImg(this,'https://showerenvy.com/cdn/shop/products/186845_ff7895c807874d80bc187d5668df6e82_mv2_1865b7e1-e296-4f4d-a8bf-7f2c5ef6bdc6.jpg?v=1762634682')"><img src="https://showerenvy.com/cdn/shop/products/186845_ff7895c807874d80bc187d5668df6e82_mv2_1865b7e1-e296-4f4d-a8bf-7f2c5ef6bdc6.jpg?v=1762634682" alt="Filter front"></div>
